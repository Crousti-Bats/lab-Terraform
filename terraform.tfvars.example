spoke_vm_admin_password = "CHANGE_ME_Spoke_Pass123!"

# Restreindre les acces (recommande)
# mgmt_allowed_source = "X.X.X.X/32"
# allowed_ssh_source  = "X.X.X.X/32"

# --- Phase 2 (config OPNsense via API) ---
enable_opnsense_config = false

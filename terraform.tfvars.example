# Copier en terraform.tfvars et remplir. NE JAMAIS commiter terraform.tfvars.

subscription_id     = "00000000-0000-0000-0000-000000000000"
prefix              = "lab"
resource_group_name = "rg_lab_agi"

# VPN IPsec (PSK identique cote Fortigate)
fortigate_public_ip  = "195.46.235.220"
onprem_address_space = ["10.118.255.0/24"]

# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is git-ignored: NEVER commit secrets to a public repo.

subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "France Central"
prefix          = "lab"

palo_alto_admin_username = "paadmin"
linux_admin_username     = "azureuser"

onprem_gateway_address = "195.46.235.220"
onprem_address_space   = ["10.118.255.0/24"]

# Restrict SSH to your own public IP, e.g. "203.0.113.10/32"
allowed_ssh_source = "*"

# --- Secrets: do NOT put them here. Pass them as environment variables ---
#
# PowerShell:
#   $env:TF_VAR_palo_alto_admin_password = '...'
#   $env:TF_VAR_linux_admin_password     = '...'
#   $env:TF_VAR_vpn_shared_key           = '...'
#
# bash:
#   export TF_VAR_palo_alto_admin_password='...'
#   export TF_VAR_linux_admin_password='...'
#   export TF_VAR_vpn_shared_key='...'

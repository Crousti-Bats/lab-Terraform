# Copier en terraform.tfvars et remplir. NE JAMAIS commiter terraform.tfvars.

subscription_id     = "00000000-0000-0000-0000-000000000000"
prefix              = "lab"
location            = "westeurope"
resource_group_name = "rg-lab-terraform"

# VPN IPsec
fortigate_public_ip  = "195.46.235.220"
onprem_address_space = ["10.118.255.0/24"]
vpn_psk              = "CHANGE_ME_strong_preshared_key"

# Identifiants VM
opnsense_admin_username = "opnadmin"
opnsense_admin_password = "CHANGE_ME_Opn_Pass123!"
spoke_vm_admin_username = "azureuser"
spoke_vm_admin_password = "CHANGE_ME_Spoke_Pass123!"

# Image Marketplace OPNsense - A VERIFIER (voir README, section Image OPNsense)
# opnsense_image = {
